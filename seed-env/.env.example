# Copie para .env e preencha. NUNCA comite o .env (está no .gitignore).

# Personal Access Token do Azure DevOps.
# Scope mínimo: Code → Read.  Use Read & Write se for dar push de volta.
# Crie em: Azure DevOps → avatar → Personal access tokens.
AZDO_PAT=

# (Opcional) Onde clonar os repos de trabalho. Default: ~/work
# No Codespaces você pode apontar para /workspaces.
# WORK_DIR=/workspaces
